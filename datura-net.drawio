          <mxGeometry x="-6750.5" y="1097.75" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-249" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.533;entryY=-0.053;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-244" target="Yh95EMxYVOAF0Q5FzLhY-246" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-251" value="7) Now thing is, any node could have or not have additional hidden services,&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;but if they have additional hidden services, their hashes &lt;br&gt;would randomly point to different positions on the hashring&lt;/font&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;:&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7131.5" y="1216.75" width="423" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-252" value="(only the nodes themselves know that they are the&lt;br&gt;&amp;nbsp;real destination of a given hidden service)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6505.5" y="833" width="286" height="41" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-253" value="the hash of a given hidden service is the only public value&lt;br&gt;that every other node has, &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;that means that they need&lt;br&gt;to know the hidden service address beforehand,&lt;br&gt;to be able to know what hidden service address&amp;nbsp;&lt;br&gt;the given hash actually refers to&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6524.5" y="741.5" width="324" height="84" as="geometry" />
        </mxCell>
