        </mxCell>
        <mxCell id="R0iengJZwtPKdWFIPyWC-105" value="the adversary can&#39;t distinguish (from looking at traffic alone,&lt;br&gt;and without running a custom client on Node B, that&amp;nbsp;&lt;br&gt;the real traffic was meant to be sent to Node A,&lt;br&gt;and that Node FGH are the decoy destinations" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-4269.25" y="4579" width="334" height="70" as="geometry" />
        </mxCell>
        <mxCell id="R0iengJZwtPKdWFIPyWC-106" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;However if Node B is controlled by the adversary:&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
