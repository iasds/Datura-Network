        <mxCell id="gpJT7tqyTfhan1vEU41s-19" value="Node C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4808" y="833" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-20" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Node A solved the RandomX challenge,&lt;br&gt;thus now Node D accepts to recieve traffic&lt;br&gt;from Node A, and cap it at 1mbps&lt;br&gt;(valid 24hrs)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-4738" y="590" width="243" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-21" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;capped at&lt;br&gt;10kbps!&lt;br&gt;(just enough to ask for &lt;br&gt;the randomx challenge,&lt;br&gt;and send it&#39;s solution.)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-4654" y="785" width="143" height="84" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-22" value="= impossible for Node B and C to try and DDoS&lt;br&gt;Node D without solving the RandomX challenge.&lt;br&gt;&lt;br&gt;+ even if they try to send too much garbage data, &lt;br&gt;then Node D would ban them for BW misuse" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-4720" y="869" width="279" height="84" as="geometry" />
        </mxCell>
