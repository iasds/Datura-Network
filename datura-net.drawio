        <mxCell id="v3IIzgveTb6yj0TpXEEh-102" value="&lt;u&gt;Node A does not decide, nor know where the connections go beyond it&#39;s own scope&lt;/u&gt;&lt;br&gt;Client A requested Node A to route traffic to node F, &lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;(without telling Node A where the packets should go from there)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;therefore Node A has to obey as otherwise it&#39;d get banned by &lt;br&gt;the client A&amp;nbsp;if it tries to misbehave&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="151.75" y="3835" width="461" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-103" value="Node A has clients connecting to it, and Node A connects to as many other Nodes as possible,&lt;br&gt;But it only does 1 hops at a time, it does not build circuits. &lt;b&gt;&lt;u&gt;Only the clients build circuits&lt;/u&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="115.5" y="3555" width="518" height="41" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-104" value="Client A should ask Node A to try sending the packets to Node F first,&lt;br&gt;(since it previously advertised itself as ready to handle the incoming load)&lt;br&gt;&lt;u&gt;if not possible, then try node J, and if not possible, to try node N,&lt;br&gt;and ban the nodes that misbehaves!&lt;/u&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="563.88" y="4077" width="407" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-105" value="&lt;u style=&quot;text-wrap-mode: nowrap;&quot;&gt;Circuit path-finding&lt;/u&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;u&gt;&amp;nbsp;to ensure delivery&lt;br&gt;+ Banning misbehaving nodes:&lt;br&gt;&lt;/u&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="295.38" y="4020" width="228" height="61" as="geometry" />
        </mxCell>
