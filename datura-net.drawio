        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.067;entryY=0.499;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="J5L8lLLXnxCU2Hx9yfRl-26" target="J5L8lLLXnxCU2Hx9yfRl-28" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-45" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Node O tried to send way too much&lt;br&gt;traffic to Node K, more than it was allowed&lt;br&gt;to send (this means that Node O modified&lt;br&gt;their client to get rid of the limits requirement)&lt;br&gt;&lt;br&gt;RESULT: Node K bans Node O for misbehaving, (for 30 mins)&lt;br&gt;and immediately refuses recieving further data from them.&lt;br&gt;If it continues after the ban expires, the ban length will keep on doubling&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1964" y="1210" width="399" height="127" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-46" value="&lt;span style=&quot;color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;Node F tried to send way too much&lt;/span&gt;&lt;br style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;traffic to Node B, A and E, more than it was allowed&lt;/span&gt;&lt;br style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;to send (this means that Node F modified&lt;/span&gt;&lt;br style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;their client to get rid of the limits requirement)&lt;/span&gt;&lt;br style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;br style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;RESULT: Node A, B and E bans Node F for misbehaving, (for 30 mins)&lt;/span&gt;&lt;br style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;and immediately refuses recieving further data from them.&lt;/span&gt;&lt;br style=&quot;forced-color-adjust: none; box-shadow: none !important; color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;If it continues after the ban expires, the ban length will keep on doubling&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1289.7455555555557" y="933.9988888888889" width="367" height="137" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-47" value="&lt;font color=&quot;#ff0000&quot;&gt;Node H&#39;s advertised binary hash (of the nowhere net daemon)&lt;br&gt;is different than the rest of the network (the network allows clients&lt;br&gt;to communicate with them if their binary hash is either the latest, &lt;br&gt;or 3 versions behind.)&lt;br&gt;&lt;br&gt;Therefore Node G bans Node H since &lt;br&gt;they are running a modified client.&lt;br&gt;&lt;br&gt;(not sure how every node should keep track of what&#39;s the latest version&lt;br&gt;available, however!)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1989.5" y="907" width="395" height="156" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-48" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Every node is expected to behave according to the protocol rules.&lt;br&gt;If any of the nodes does not behave as expected, the network rejects&lt;br&gt;them, like an autoimmune system. All cells reject the cancerous cells.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1533.25" y="838" width="386" height="55" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-49" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;u&gt;Rate limitations and RandomX PoW to &lt;br&gt;prevent DDoS of hidden services&lt;/u&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-709" y="4754" width="253" height="61" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.04;entryY=0.323;entryDx=0;entryDy=0;exitX=0.974;exitY=0.315;exitDx=0;exitDy=0;exitPerimeter=0;entryPerimeter=0;fillColor=#fa6800;strokeColor=#C73500;" parent="1" source="J5L8lLLXnxCU2Hx9yfRl-50" target="J5L8lLLXnxCU2Hx9yfRl-51" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-438" y="4959" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-50" value="&lt;font color=&quot;#33f933&quot;&gt;Node A&lt;br&gt;(User)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-618" y="4937" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="J5L8lLLXnxCU2Hx9yfRl-51" target="J5L8lLLXnxCU2Hx9yfRl-50" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-51" value="&lt;font color=&quot;#33f933&quot;&gt;Node B&lt;br&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-329.63" y="4937" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-53" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;2) Node B: &lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;i wont answer you unless if you &lt;br&gt;solve this RandomX challenge first!&lt;br&gt;(if the same node asks 5 times without providing&lt;br&gt;the solved challenge, then node B blocks node A)&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-444.63" y="4861" width="301" height="70" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-55" value="&lt;font style=&quot;color: rgb(255, 128, 0);&quot;&gt;1) Node A: give me your status!&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-678" y="4909" width="185" height="26" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-57" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.275;entryY=0.922;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="J5L8lLLXnxCU2Hx9yfRl-50" target="J5L8lLLXnxCU2Hx9yfRl-50" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-582" y="5012" />
              <mxPoint x="-583" y="5012" />
              <mxPoint x="-583" y="5020" />
              <mxPoint x="-598" y="5020" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-58" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;3) (Consumes some CPU &lt;br&gt;power to be able&lt;br&gt;to solve Node B&#39;s &lt;br&gt;RandomX Challenge)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-668" y="5014" width="155" height="70" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-59" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.019;entryY=0.608;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="J5L8lLLXnxCU2Hx9yfRl-50" target="J5L8lLLXnxCU2Hx9yfRl-51" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-438" y="4981" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-61" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;4) Valid RandomX Challenge solution!&lt;br&gt;performing the task to get the status and&lt;br&gt;send it back to Node A&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-412.25" y="5008" width="233" height="55" as="geometry" />
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.944;entryY=0.755;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="J5L8lLLXnxCU2Hx9yfRl-51" target="J5L8lLLXnxCU2Hx9yfRl-50" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-438" y="4991" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="J5L8lLLXnxCU2Hx9yfRl-63" value="This could be the default behavior for &lt;br&gt;when a Node is overloaded, or when another Node&lt;br&gt;is suspected of spamming. (OR it could literally be the default&lt;br&gt;behavior for all nodes / hidden services / rendezvous creation requests)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-493.13" y="4796" width="398" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-1" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;u&gt;if a node asks your node to route packets to another node, &lt;br&gt;you must send it there AND always to 2 other decoy destinations&lt;/u&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-727.5" y="5177" width="379" height="61" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#008a00;strokeColor=#005700;" parent="1" source="hRJDUBrgxpCJInATjKRH-2" target="hRJDUBrgxpCJInATjKRH-5" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-196" y="5358" />
              <mxPoint x="-196" y="5246" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-2" value="&lt;font color=&quot;#33f933&quot;&gt;Node B&lt;br&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-329.25" y="5322" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="hRJDUBrgxpCJInATjKRH-3" target="hRJDUBrgxpCJInATjKRH-2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-3" value="&lt;font color=&quot;#33f933&quot;&gt;Node A&lt;br&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-500" y="5322" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-4" value="&lt;font color=&quot;#33f933&quot;&gt;Node C&lt;br&gt;(real&lt;br&gt;destination)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-167.5" y="5317.25" width="80.5" height="80.5" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-5" value="&lt;font color=&quot;#33f933&quot;&gt;Node D&lt;br&gt;(Decoy&lt;br&gt;destination 1)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-160.25" y="5210" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-6" value="&lt;font color=&quot;#33f933&quot;&gt;Node E&lt;br&gt;(Decoy&lt;br&gt;destination 2)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-160.25" y="5437" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.007;entryY=0.52;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#008a00;strokeColor=#005700;" parent="1" source="hRJDUBrgxpCJInATjKRH-2" target="hRJDUBrgxpCJInATjKRH-6" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-196" y="5358" />
              <mxPoint x="-196" y="5474" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-11" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;A: &quot;Hey B, forward this packet to C!&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-539.25" y="5296" width="210" height="26" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="hRJDUBrgxpCJInATjKRH-2" target="hRJDUBrgxpCJInATjKRH-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-12" value="&lt;font style=&quot;color: rgb(255, 128, 0);&quot;&gt;B will accept to forward packets&lt;br&gt;to the real destination C,&lt;br&gt;ONLY IF it has 2 other decoy&lt;br&gt;destinations to forward the &lt;br&gt;same packets to (here, D and E)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-407" y="5393" width="191" height="84" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-14" value="&lt;u&gt;Every daemon is a node,&lt;br&gt;Every node has a Hidden service,&lt;br&gt;hence every node is a potential valid decoy destination&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
