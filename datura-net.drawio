        <mxCell id="gpJT7tqyTfhan1vEU41s-75" value="Anonymity set:&lt;br&gt;1/1000 nodes&lt;br&gt;&lt;u&gt;(you can send up &lt;br&gt;to 1mbps)&lt;br&gt;&lt;/u&gt;(total bw: 1Gbps)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-4947" y="1549" width="110" height="84" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-77" value="&lt;font&gt;&lt;font color=&quot;#00ff00&quot;&gt;Each Node is like a restaurant, they have seats.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;Small nodes will have few seats (like Node E),&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;Large nodes will have alot of seats (like Node I or G),&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;If a given node has all seats taken right now, then they either&lt;br&gt;refuse to take any more connections, or they accept but reduce&lt;br&gt;every current customers&#39; allocated bandwidth.&lt;br&gt;&lt;/font&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-5208" y="1650" width="354" height="113" as="geometry" />
        </mxCell>
