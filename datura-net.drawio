        <mxCell id="1kGoJ9DRA0M_nVFC86Ni-13" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;the bandwidth of&amp;nbsp;&lt;br&gt;B-&amp;gt;C-&amp;gt;D should remain at &lt;br&gt;the default minimum&amp;nbsp;&lt;br&gt;(only enough to ask for randomx challenges&lt;br&gt;and provide the randomx solutions to be&lt;br&gt;granted the regular bandwidth pass)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1159" y="337" width="251" height="98" as="geometry" />
        </mxCell>
        <mxCell id="1kGoJ9DRA0M_nVFC86Ni-14" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;the bandwidth of A -&amp;gt; C -&amp;gt; D&lt;br&gt;should be at the allowed 1mbps&lt;br&gt;since A solved the RandomX challenge of&lt;br&gt;Node C and Node D (and will remain so&lt;br&gt;for 24 hours or until he consumes 100mbps)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1146" y="214" width="253" height="84" as="geometry" />
        </mxCell>
        <mxCell id="1kGoJ9DRA0M_nVFC86Ni-15" value="Node C recieves the packet,&lt;br&gt;decrypts the packet&lt;br&gt;and in that packet it reads &lt;br&gt;that it contains the randomX solution,&lt;br&gt;along with the instructions (foward it to Node D)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-938" y="291.5" width="270" height="84" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-1" value="&lt;u&gt;Nodes allocate bandwidth for other nodes if they solve RandomX challenges&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-5334" y="535" width="154" height="61" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#d80073;strokeColor=#A50040;" parent="1" source="gpJT7tqyTfhan1vEU41s-2" target="gpJT7tqyTfhan1vEU41s-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-2" value="Node A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
