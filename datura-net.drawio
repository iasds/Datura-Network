        <mxCell id="AzgI3BM7G08beJRFnDTX-18" value="&quot;hey K,route this Packet&lt;br&gt;to the hidden service&lt;br&gt;whose hash is &amp;lt;hash1&amp;gt;&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
