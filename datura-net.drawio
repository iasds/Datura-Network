          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-6" value="Node B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-5279" y="760" width="60" height="60" as="geometry" />
        </mxCell>
