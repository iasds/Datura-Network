        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-307" value="1-A:&quot;Hey I, forward this message to J for me !&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
