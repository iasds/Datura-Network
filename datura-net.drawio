        <mxCell id="7t-b7eh4lVvnXBe4pymd-166" value="2 decoys nodes per hop:&lt;br&gt;n hops = nx2 decoy destinations&lt;br&gt;3 hops = 6 decoy destinations&lt;br&gt;&lt;br&gt;cheap and each node along the way&lt;br&gt;doesn&#39;t know which is the real destination,&lt;br&gt;but the adversary can tell which are the decoy nodes&lt;br&gt;by noticing that they are not forwarding &lt;br&gt;the traffic elsewhere" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5462.25" y="7121" width="298" height="142" as="geometry" />
        </mxCell>
        <mxCell id="7t-b7eh4lVvnXBe4pymd-167" value="2 decoy paths per destination:&lt;br&gt;n hops = nx2 decoy destinations&lt;br&gt;3 hops = 6 decoy destinations&lt;br&gt;&lt;br&gt;cheap but each node along the way &lt;br&gt;can see a clear source and destination" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-5146.5" y="7124" width="223" height="98" as="geometry" />
        </mxCell>
        <mxCell id="7t-b7eh4lVvnXBe4pymd-168" value="2 decoy nodes per hop, &lt;br&gt;and every path that comes out of &lt;br&gt;the client node must be 3 hops long: (expensive)&lt;br&gt;&lt;br&gt;n hops = 3^n destinations&lt;br&gt;3 hops = 3^3 destinations = 27 destinations&lt;br&gt;&lt;br&gt;Really fucking expensive, but each node along the&lt;br&gt;way doesn&#39;t know which is the real destination,&amp;nbsp;&lt;br&gt;and the outside adversary can&#39;t tell which are the decoy nodes&lt;br&gt;because even the decoy nodes are branching outward,&lt;br&gt;each of the final 27 destinations could be the real destination" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="-4793" y="7117" width="349" height="185" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
