          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-2274" y="2248" />
              <mxPoint x="-2274" y="2248" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-10" target="Ks_VO9Inp2RuTejZyS4B-29" edge="1">
