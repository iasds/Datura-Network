        <mxCell id="Ks_VO9Inp2RuTejZyS4B-245" value="Node B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" parent="1" vertex="1">
          <mxGeometry x="-1881" y="108" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-264" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#008a00;strokeColor=#005700;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-246" target="Ks_VO9Inp2RuTejZyS4B-245" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-246" value="Node G" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" parent="1" vertex="1">
          <mxGeometry x="-2025" y="185.5" width="53" height="53" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-265" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#008a00;strokeColor=#005700;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-247" target="Ks_VO9Inp2RuTejZyS4B-245" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-247" value="Node F" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" parent="1" vertex="1">
          <mxGeometry x="-2024.5" y="24" width="52" height="52" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-255" value="1) A: &quot;Hey F, forward this packet to B!&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2255" y="74" width="221" height="26" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-256" value="2) A: &quot;Hey G, forward this packet to B!&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2256" y="164.5" width="224" height="26" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-258" value="3) A, F and G all send the following packet to B,&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;(and B needs to wait to recieve all 3 before trying to decrypt it)&lt;/font&gt;&lt;br&gt;&quot;Hey B, send this packet to destination C, E and D!&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1992.5" y="-7" width="348" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-259" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;That way, B can&#39;t tell &lt;br&gt;if the real destination is E, C or D,&lt;br&gt;&lt;b&gt;because only Node A knows &lt;br&gt;which are the decoy destinations&lt;/b&gt;&lt;br&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1959" y="-161" width="207" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-260" value="Node D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" parent="1" vertex="1">
          <mxGeometry x="-1658.5" y="190.5" width="53" height="53" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-261" value="Node E" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" parent="1" vertex="1">
          <mxGeometry x="-1657.5" y="22" width="52" height="52" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-251" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-243" target="Ks_VO9Inp2RuTejZyS4B-245" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-257" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-245" target="Ks_VO9Inp2RuTejZyS4B-244" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-234" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-232" target="Ks_VO9Inp2RuTejZyS4B-230" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-267" value="&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;That way, B can&#39;t tell&lt;/span&gt;&lt;br style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;if the real source is A,F or G,&lt;/span&gt;&lt;br style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b style=&quot;color: rgb(255, 0, 0);&quot;&gt;because only Node A knows&lt;br&gt;which are the decoy sources&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1909" y="166.5" width="182" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-268" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;For B to know which destinations &lt;br&gt;were the decoy destinations,&lt;br&gt;the adversary would need to &lt;br&gt;control both decoy destinations aswell &lt;br&gt;(B, E and D)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1549" y="-225.5" width="220" height="84" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-269" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;For B to know which sources were the&amp;nbsp;&lt;br&gt;decoy sources, the adversary would need to control&lt;br&gt;both decoy destinations aswell.&lt;br&gt;(meaning B needs to also control F and G)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1578" y="24" width="292" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-270" value="&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;For B to know which was both &lt;br&gt;the real source AND the real destination,&lt;br&gt;B needs to control E,D F and G aswell.&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1548" y="136.5" width="233" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-271" value="&lt;u&gt;SIMPLIFYING ANONYMITY AS MUCH AS POSSIBLE: 0 hop thought experiment&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-2768" y="-427" width="228" height="61" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-303" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fillColor=#008a00;strokeColor=#005700;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-283" target="Ks_VO9Inp2RuTejZyS4B-296" edge="1">
