          <mxGeometry x="-5279" y="1071.5" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-40" value="Node D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-5042" y="1174.5" width="60" height="60" as="geometry" />
        </mxCell>
