          <mxGeometry x="2034.25" y="4483" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-289" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=8;fillColor=#a20025;strokeColor=#6F0000;" parent="1" source="v3IIzgveTb6yj0TpXEEh-288" target="v3IIzgveTb6yj0TpXEEh-264" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-288" value="Node B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1644.75" y="4319" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-291" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#a20025;strokeColor=#6F0000;" parent="1" source="v3IIzgveTb6yj0TpXEEh-290" target="v3IIzgveTb6yj0TpXEEh-264" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-290" value="Node C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1507.25" y="4326" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-292" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;u style=&quot;&quot;&gt;The problem:&lt;/u&gt;&lt;br&gt;The traffic shape, timing and size ITSELF&lt;br&gt;could deanonymize users if the adversary&lt;br&gt;is looking at the traffic shape!&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1482.25" y="4249" width="239" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-294" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=6;fillColor=#a20025;strokeColor=#6F0000;" parent="1" source="v3IIzgveTb6yj0TpXEEh-293" target="v3IIzgveTb6yj0TpXEEh-283" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-293" value="Node B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1995.25" y="4313" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-296" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#a20025;strokeColor=#6F0000;" parent="1" source="v3IIzgveTb6yj0TpXEEh-295" target="v3IIzgveTb6yj0TpXEEh-283" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-295" value="Node C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1862.25" y="4313" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-297" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;&lt;u&gt;The solution:&lt;/u&gt;&lt;br&gt;The traffic shape, timing and size is the same for as many users&lt;br&gt;as possible. all traffic that goes out of the Node A to clients must&amp;nbsp;&lt;br&gt;be identical to the traffic being sent out to other clients.&lt;br&gt;&lt;br&gt;(ideally the node itself shouldn&#39;t even know that client B &lt;br&gt;is the real destination, idk if it&#39;s doable?)&lt;br&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1774.25" y="4200" width="361" height="113" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-298" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;(ideally, the node needs to be ran&lt;br&gt;by at least one legit client)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1977.25" y="4388" width="195" height="41" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-299" value="&lt;span style=&quot;text-wrap-mode: nowrap;&quot;&gt;&lt;u&gt;Nodes discover where they need to &lt;br&gt;send the traffic to, upon decrypting the traffic?&lt;/u&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="204.75" y="4717" width="261.62" height="61" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-318" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="v3IIzgveTb6yj0TpXEEh-300" target="v3IIzgveTb6yj0TpXEEh-315" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-300" value="Node A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="580" y="4841" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-325" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="v3IIzgveTb6yj0TpXEEh-301" target="v3IIzgveTb6yj0TpXEEh-324" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-301" value="Node B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="809.75" y="4841" width="45" height="45" as="geometry" />
