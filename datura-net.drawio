          <mxGeometry x="-4311" y="751" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-29" value="Node C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4311" y="851" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-31" value="However When it comes to Node D responding Data back to Node A,B and C,&lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Node D advertises that they are going to respond at 1mbps for both the&amp;nbsp;&lt;br&gt;real destinations and the decoy destinations, &lt;br&gt;even if they didn&#39;t solve Node D&#39;s randomX challenge&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-4293.88" y="596" width="432" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-36" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;(Node D already solved Node A,B and C&#39;s RandomX Challenges however,&lt;br&gt;which allows Node D to respond at 1mbps to both the real destination&lt;br&gt;and the decoy destinations at the same time.)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-4135.88" y="813" width="413" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#008a00;strokeColor=#005700;strokeWidth=5;" parent="1" source="gpJT7tqyTfhan1vEU41s-39" target="gpJT7tqyTfhan1vEU41s-40" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
