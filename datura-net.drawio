        <mxCell id="v3IIzgveTb6yj0TpXEEh-134" value="&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;3) not possible via &lt;br&gt;node J either&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
