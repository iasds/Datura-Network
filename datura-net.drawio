        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-244" value="Node C&lt;br&gt;(real destination)" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" parent="1" vertex="1">
          <mxGeometry x="-1673" y="90" width="82" height="82" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-262" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#008a00;strokeColor=#005700;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-245" target="Ks_VO9Inp2RuTejZyS4B-261" edge="1">
