          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-7" value="Node C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-5279" y="860" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-11" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;by default, node D restricts the incoming bandwidth to&lt;br&gt;10kbps, so that Nodes A,B and C can&#39;t DDOS &lt;br&gt;and are forced to ask for the&amp;nbsp;randomX challenge and solve it&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-5208" y="627" width="339" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-12" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;capped at&lt;br&gt;10kbps!&lt;br&gt;(just enough to ask for &lt;br&gt;the randomx challenge,&lt;br&gt;and send it&#39;s solution.)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-5125" y="812" width="143" height="84" as="geometry" />
        </mxCell>
