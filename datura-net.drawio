        <mxCell id="Ks_VO9Inp2RuTejZyS4B-298" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-294" target="Ks_VO9Inp2RuTejZyS4B-283" edge="1">
