        </mxCell>
        <mxCell id="HgBr_yeDXLSilMWp8V1L-88" value="&lt;b&gt;IF A NODE MISBEHAVES (meaning it starts to send packets of the wrong size, at the wrong timing, with no decoys) THEN NODES MUST REFUSE TO TALK TO IT PERIOD!&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;" parent="1" vertex="1">
          <mxGeometry x="375" y="649" width="261" height="60" as="geometry" />
        </mxCell>
