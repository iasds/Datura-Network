        <mxCell id="AzgI3BM7G08beJRFnDTX-19" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Node K should&lt;br&gt;not know the full path back to the&lt;br&gt;actual hidden service destination,&lt;br&gt;ONLY THE FIRST HOP!&lt;br&gt;&lt;br&gt;because Node K can also &lt;br&gt;be ran by the adversary!&lt;/font&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6196" y="2041.25" width="195" height="113" as="geometry" />
        </mxCell>
        <mxCell id="AzgI3BM7G08beJRFnDTX-21" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Node K must not be able to know&lt;br&gt;which are the next 2 nodes on the path&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
