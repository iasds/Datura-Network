        <mxCell id="yjcX_oRv-ezx0EmfgUO8-93" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="yjcX_oRv-ezx0EmfgUO8-57" target="yjcX_oRv-ezx0EmfgUO8-66" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-102" value="&lt;font style=&quot;color: rgb(51, 249, 51);&quot;&gt;green = destination traffic &lt;br&gt;(can either be &lt;/font&gt;&lt;font style=&quot;color: rgb(51, 249, 51);&quot;&gt;noise decoys&lt;/font&gt;&lt;font style=&quot;color: rgb(51, 249, 51);&quot;&gt; or legit obfuscated traffic) /!\&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;red = source traffic (already padded)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2043" y="1587" width="316" height="55" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-112" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.001;entryY=0.447;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="yjcX_oRv-ezx0EmfgUO8-50" target="yjcX_oRv-ezx0EmfgUO8-67" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-118" value="&lt;font style=&quot;color: rgb(51, 249, 51);&quot;&gt;Decoy destination 1&lt;br&gt;traffic (part 1)&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="yjcX_oRv-ezx0EmfgUO8-112" vertex="1" connectable="0">
          <mxGeometry x="-0.0946" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-113" value="&lt;b&gt;the nodes dictate how much traffic they can recieve from each client,&lt;br&gt;depending on how much traffic they sent them&lt;br&gt;(no matter how much traffic the user tries to force into the network)&lt;br&gt;This is also enforced from the clientside, following the same rules!&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2181" y="1661" width="411" height="70" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="yjcX_oRv-ezx0EmfgUO8-123" target="yjcX_oRv-ezx0EmfgUO8-150" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-123" value="&lt;font color=&quot;#33f933&quot;&gt;Client A&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1708" y="2315" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#008a00;strokeColor=#005700;entryX=0.99;entryY=0.316;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="yjcX_oRv-ezx0EmfgUO8-150" target="yjcX_oRv-ezx0EmfgUO8-123" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1938" y="2338" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-150" value="&lt;font color=&quot;#33f933&quot;&gt;Node A&amp;nbsp;&lt;br&gt;(Serverside)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="2097" y="2315" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-152" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;client A recieved 10Mb of noise traffic from me,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;client A is now allowed to send me 2.5Mb of traffic&lt;/font&gt;&lt;br&gt;(client is able to send 1/4 of the amount of traffic he recieved)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1961" y="2386" width="343" height="55" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-153" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;I recieved and discarded 10Mb of noise traffic from node A,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;I now know that i can send Node A 2.5Mb of traffic.&lt;/font&gt;&lt;br&gt;(and i will do that if i need to)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1584" y="2381" width="331" height="55" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-154" value="&lt;u&gt;DECOY TRAFFIC DESTINATIONS:&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="414" y="2169" width="228" height="61" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-155" value="&lt;u&gt;CLIENTS CAN SEND 1/4th OF THE NOISE TRAFFIC THEY RECIEVED&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1530" y="2245" width="228" height="61" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-156" value="&lt;u&gt;NODES FORWARD TRAFFIC TO THE REAL DESTINATION, BUT ALSO TO 2 OTHER DECOY DESTINATIONS&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1562" y="1548" width="228" height="61" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-157" value="The nodes that forward traffic remember where the decoy destinations are,&lt;br&gt;and they will keep trying to send the data to those destinations in the long run.&lt;br&gt;&lt;b&gt;Ideally the decoy destination should have a near-100% uptime&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2227" y="2129" width="432" height="55" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-1" value="&lt;u&gt;INCENTIVES TO RUN NODES:&lt;br&gt;&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1562" y="2510" width="228" height="61" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="H5vF-BcA8RPjxxUbLKuJ-2" target="H5vF-BcA8RPjxxUbLKuJ-4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="H5vF-BcA8RPjxxUbLKuJ-2" target="H5vF-BcA8RPjxxUbLKuJ-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-2" value="&lt;font color=&quot;#33f933&quot;&gt;Client A&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1714" y="2593" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-3" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;span&gt;Node B&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span&gt;(ran on a VPS by client B)&lt;/span&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="2090" y="2703" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-4" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Node A&amp;nbsp;&lt;br&gt;(ran on a VPS by client A)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="2090" y="2593" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-5" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Client B&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1714" y="2703" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-8" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;if client A tries to send traffic via node A:&lt;br&gt;the client A&#39;s traffic gets the priority over client B&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1805" y="2584" width="272" height="41" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-9" value="&lt;u&gt;optional feature:&lt;/u&gt;&lt;br&gt;Node A can have a special config whitelisting&lt;br&gt;Client A&#39;s public key as a VIP user, to make sure&lt;br&gt;his traffic always goes before other clients &lt;br&gt;(on this node at least)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2164" y="2586.5" width="275" height="84" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-10" value="&lt;font style=&quot;color: rgb(255, 0, 0); background-color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;if client A tries to send traffic via node B:&lt;/span&gt;&lt;br style=&quot;forced-color-adjust: none; font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; box-shadow: none !important;&quot;&gt;&lt;span style=&quot;font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;the client A&#39;s traffic doesn&#39;t get &lt;br&gt;the priority over client B&#39;s traffic&lt;br&gt;(hence the incentive to run your own node)&lt;/span&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="1824.9999999999998" y="2738" width="282" height="51" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-11" value="&lt;u&gt;Outgoing proxies:&lt;/u&gt;&lt;br&gt;(completely optional feature,&lt;br&gt;as nowherenet intends to remain&lt;br&gt;darknet only)" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1517.5" y="4741" width="206" height="70" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-13" value="&lt;font color=&quot;#00ff00&quot;&gt;Node A&lt;br&gt;(Private&lt;br&gt;outgoing&lt;br&gt;proxy)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1762.5" y="4758" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-14" value="&lt;font color=&quot;#ff0000&quot;&gt;Node B&lt;br&gt;(Public&lt;br&gt;outgoing&lt;br&gt;proxy)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1767" y="4858" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-15" value="&lt;font color=&quot;#00ff00&quot;&gt;Client A Whitelisted himself on his own node A,&lt;br&gt;that way, he&#39;s the only one that can use this node as &lt;br&gt;an outgoing proxy (that also prevents potentially sensitive&lt;br&gt;traffic from going through your infrastructure, which could&lt;br&gt;lead to VPS takedowns / police raids)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1841.5" y="4751" width="323" height="84" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-16" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Client B allowed any user to use this node as an &lt;br&gt;outgoing proxy. (This means that he&#39;s ready to allow&lt;br&gt;potentially sensitive traffic to go through his infrastructure)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1840.5" y="4866" width="325" height="55" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-17" value="This is to prevent an adversary from figuring out the real location of a hidden service,&lt;br&gt;even if he continuously tries to send traffic there." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2194" y="2187" width="468" height="41" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-18" value="TODO:&lt;br&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-read the rest of the tor files&lt;br&gt;-write blogpost conclusion on the tor files + mention it on all tor tutorials&lt;br&gt;-create the nowherenet repository&lt;br&gt;-draft the roadmap for it (protocol, daemon, TCP hidden services,&amp;nbsp;&lt;/span&gt;browser, etc)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;-get criticism on it&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;-make kuno fundraisers ?&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="968" y="120" width="436" height="113" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-19" value="&lt;u&gt;Bridges hidden by design:&lt;br&gt;(if possible)&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="2397.5" y="4710" width="158" height="44" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-20" value="&lt;font color=&quot;#00ff00&quot;&gt;Bridge &lt;br&gt;Node A&lt;br&gt;IP:9050&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="2414.5" y="4776" width="71" height="71" as="geometry" />
