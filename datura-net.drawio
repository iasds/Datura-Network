          <mxGeometry x="-4572.5" y="1176" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-53" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=5;fillColor=#008a00;strokeColor=#005700;" parent="1" source="gpJT7tqyTfhan1vEU41s-50" target="gpJT7tqyTfhan1vEU41s-49" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-50" value="Node B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4809.5" y="1176" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-51" value="Node C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4809.5" y="1276" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-52" value="Node A&amp;nbsp; and B solved D&#39;s RandomX Challenge,&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;but since Node A and B are D&#39;s only clients,&lt;br&gt;then D refuses to forward responses back to A&lt;br&gt;because there&#39;s no crowd for &lt;br&gt;A and B&#39;s traffic to blend into &lt;br&gt;(there must be at least 3 clients per node)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-4650" y="1078" width="271" height="98" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#008a00;strokeColor=#005700;strokeWidth=5;" parent="1" source="gpJT7tqyTfhan1vEU41s-56" target="gpJT7tqyTfhan1vEU41s-57" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-56" value="Node A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4293.88" y="1065.5" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-57" value="Node D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4056.88" y="1168.5" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-58" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=5;fillColor=#008a00;strokeColor=#005700;" parent="1" source="gpJT7tqyTfhan1vEU41s-59" target="gpJT7tqyTfhan1vEU41s-57" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-59" value="Node B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4293.88" y="1168.5" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-62" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=5;fillColor=#008a00;strokeColor=#005700;" parent="1" source="gpJT7tqyTfhan1vEU41s-60" target="gpJT7tqyTfhan1vEU41s-57" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-60" value="Node C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4293.88" y="1268.5" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-61" value="Node A, B and C solved D&#39;s RandomX Challenge,&lt;br&gt;&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); color: rgb(0, 255, 0);&quot;&gt;A B and C are a big enough crowd of 3 for responses&lt;br&gt;to be blended into, therefore Node D&lt;br&gt;accepts to foward data back to eith A, B or C.&lt;br&gt;&lt;b&gt;(any of them can be the real destination, &lt;br&gt;or just a decoy destination.)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-4133.75" y="1065" width="300" height="98" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-63" value="&lt;u&gt;Nodes refuse to foward traffic responses if the crowd isn&#39;t big enough to have decoy destinations&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-5360" y="988" width="154" height="61" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-64" value="&lt;u&gt;Nodes Advertise the anonymity set they &lt;br&gt;currently provide&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-5360" y="1417.25" width="154" height="61" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-65" value="Node E&lt;br&gt;(Mobile Device)" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-5302" y="1494" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-66" value="Node F&lt;br&gt;(laptop)" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-5178" y="1492" width="64" height="64" as="geometry" />
        </mxCell>
