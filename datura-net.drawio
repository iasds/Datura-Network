        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#008a00;strokeColor=#005700;" parent="1" source="H5vF-BcA8RPjxxUbLKuJ-24" target="H5vF-BcA8RPjxxUbLKuJ-20" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-24" value="&lt;font color=&quot;#00ff00&quot;&gt;Client A&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="2248.5" y="4776" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#a20025;strokeColor=#6F0000;" parent="1" source="H5vF-BcA8RPjxxUbLKuJ-26" target="H5vF-BcA8RPjxxUbLKuJ-20" edge="1">
