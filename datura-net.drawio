        <mxCell id="R0iengJZwtPKdWFIPyWC-131" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;A&#39;s sending real traffic to B (which it trusts)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;and at the same time sending decoy traffic to other nodes&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
