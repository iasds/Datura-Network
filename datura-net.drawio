        <mxCell id="-UtkbLpVgZfD95B3Hxab-1" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;If what goes into the &lt;br&gt;controlled adversary nodes&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;is coming from your IP:&lt;br&gt;game over for the client&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
