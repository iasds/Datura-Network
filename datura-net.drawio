        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-26" value="&lt;font&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;malicious adversary&lt;/font&gt;&lt;br&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="2248.5" y="4914" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-29" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;TCP port scanning: (invalid requests)&lt;br&gt;= EITHER ZERO RESPONSE FROM THE SERVER&lt;br&gt;OR HTTP WEBSITE TRAFFIC IS SHOWN&lt;br&gt;(forwarding traffic to bing.com or something similar)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2449.5" y="4883" width="297" height="70" as="geometry" />
        </mxCell>
        <mxCell id="H5vF-BcA8RPjxxUbLKuJ-30" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;valid requests&lt;br&gt;made to a&lt;br&gt;nowherenet&lt;br&gt;node&lt;/font&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2319.5" y="4776" width="92" height="70" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-1" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;&lt;b&gt;AND THE ELEPHANT IN THE ROOM:&lt;br&gt;USING THE NODE YOU RUN MEANS THAT&lt;br&gt;YOU PREVENT A STATE ADVERSARY&lt;br&gt;THAT POTENTIALLY CONTROLS&amp;nbsp;&lt;br&gt;MOST OF THE NODES&amp;nbsp;FROM &lt;br&gt;DEANONYMIZING YOU !!!&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1556.75" y="2821" width="261" height="98" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-15" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0E1yibbuvkSa4QKFoASH-2" target="0E1yibbuvkSa4QKFoASH-11" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-2" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Node A&amp;nbsp;&lt;br&gt;(ran on a VPS by client A)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1716" y="3050" width="71" height="71" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-21" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="0E1yibbuvkSa4QKFoASH-3" target="0E1yibbuvkSa4QKFoASH-2" edge="1">
