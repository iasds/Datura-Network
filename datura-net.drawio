        <mxCell id="i-VnWK1uksur5Cd8t2WV-159" value="X" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#a20025;strokeColor=#6F0000;fontColor=#ffffff;" parent="i-VnWK1uksur5Cd8t2WV-160" vertex="1">
