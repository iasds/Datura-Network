        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-236" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="v3IIzgveTb6yj0TpXEEh-222" target="v3IIzgveTb6yj0TpXEEh-214" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-222" value="3x Nodes" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="1888.5" y="3825" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-223" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.049;entryY=0.485;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="v3IIzgveTb6yj0TpXEEh-215" target="v3IIzgveTb6yj0TpXEEh-219" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-227" value="RendezVous &lt;br&gt;points" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1820" y="3578" width="86" height="41" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-233" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.034;entryY=0.587;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="v3IIzgveTb6yj0TpXEEh-219" target="v3IIzgveTb6yj0TpXEEh-213" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-235" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.006;entryY=0.561;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#60a917;strokeColor=#2D7600;" parent="1" source="v3IIzgveTb6yj0TpXEEh-221" target="v3IIzgveTb6yj0TpXEEh-212" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-237" value="Then, Client A both tries to send&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;the data to Client B&#39;s hidden service&lt;/font&gt;, but also&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;to 3 other clients&#39;s hidden services (C, D and E),&lt;br&gt;as decoys!&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1498.5" y="3551" width="274" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-228" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#a20025;strokeColor=#6F0000;" parent="1" source="v3IIzgveTb6yj0TpXEEh-200" target="v3IIzgveTb6yj0TpXEEh-216" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1687.5" y="3738" />
              <mxPoint x="1687.5" y="3711" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-238" value="None of the nodes can know for whom the encrypted data is for,&lt;br&gt;they just forward it to where they&#39;re asked (by client A) to forward it to." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1615" y="3870.5" width="388" height="41" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-239" value="ONLY the clients can know if the package is for them or not, &lt;br&gt;when they try to decrypt it:" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1986.5" y="3543" width="336" height="41" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-240" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;i can&#39;t decrypt it: discarding packets as noise&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2041.5" y="3619" width="255" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-243" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;I can decrypt it!, accepting it as real traffic&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2047.5" y="3697.5" width="239" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-244" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;i can&#39;t decrypt it: discarding packets as noise&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2044.5" y="3763.5" width="255" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-245" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;i can&#39;t decrypt it: discarding packets as noise&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="2047.5" y="3834.5" width="255" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-247" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Problem however, how does client A know where to send the traffic to the&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;3 other decoy destinations ? those aren&#39;t publicly listed.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Maybe he uses the 3 random previous hidden services&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;that he previously browsed to use them as decoy destinations ?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1681.25" y="3947" width="406" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-248" value="&lt;u&gt;The Guard Nodes (those that talk&lt;br&gt;to users), ensures that users&#39; traffic looks the same&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="1417" y="4166" width="228" height="61" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-272" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fillColor=#a20025;strokeColor=#6F0000;" parent="1" source="v3IIzgveTb6yj0TpXEEh-264" target="v3IIzgveTb6yj0TpXEEh-269" edge="1">
