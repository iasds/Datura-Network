        </mxCell>
        <mxCell id="R0iengJZwtPKdWFIPyWC-117" value="&lt;u&gt;A&#39;s anonymity set here is 1 out of 4&lt;/u&gt;&lt;br&gt;(blending in with the crowd of F, G and H)&lt;br&gt;&lt;br&gt;&lt;b&gt;F G and H don&#39;t trust Node B, but they&lt;br&gt;accept to recieve decoy traffic from B&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
