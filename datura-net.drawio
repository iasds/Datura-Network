        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-422" value="Node KN14" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6504" y="1803.25" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-423" value="Node KN13" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6504" y="1722.75" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-424" value="Node KN19" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6812" y="1881.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-425" value="Node KN20" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6812" y="1802.75" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-426" value="Node KN21" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6812" y="1724" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-427" value="Node KN12" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6574" y="1648.75" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-428" value="Node KN11" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6655" y="1648.75" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-429" value="Node KN10" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6732" y="1651.25" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-430" value="Node KN16" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6574" y="1946" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-431" value="Node KN17" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6655" y="1946" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-432" value="Node KN18" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6732" y="1948.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-440" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.502;entryY=0.944;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-408" target="Yh95EMxYVOAF0Q5FzLhY-427" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-445" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.98;entryY=0.445;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-412" target="Yh95EMxYVOAF0Q5FzLhY-424" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-446" value="12) Each Node, (starting with node K) tells it&#39;s neighbor nodes the following:&lt;br&gt;&lt;font&gt;&lt;font color=&quot;#00ffff&quot;&gt;&quot;I know who knows the RDV point for&lt;/font&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&amp;nbsp;&lt;span style=&quot;text-wrap-mode: wrap;&quot;&gt;&lt;font style=&quot;color: rgb(0, 255, 255);&quot;&gt;44AWDAWDSWA!&quot;&lt;/font&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6846" y="1590.75" width="420" height="41" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-447" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;REMINDER: Node K1 -&amp;gt; KN21 are all neighbors&lt;br&gt;to the RDV Node K, their node hash starts with&lt;br&gt;the same character as Node K&#39;s.&lt;br&gt;&lt;br&gt;THEY DO NOT COMMUNICATE OUTSIDE&lt;br&gt;OF THEIR NEIGHBORHOOD!&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6428" y="1641" width="275" height="98" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-448" value="&lt;font&gt;&lt;font color=&quot;#ffff00&quot;&gt;That way, for any client that wants to access the&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#ffff00&quot;&gt;hidden service whose hash is 44AWDAWDSWA,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#ffff00&quot;&gt;they can just ask anyone in the neighborhood&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#ffff00&quot;&gt;where the rendezvous point for 44AWDAWSWA&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#ffff00&quot;&gt;should be on the hashring!&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;&lt;b&gt;(and &lt;u&gt;everyone in this neighborhood should know&lt;br&gt;who knows where the rendezvous is&lt;/u&gt;)&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6440" y="1759.75" width="299" height="127" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-452" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-449" target="Yh95EMxYVOAF0Q5FzLhY-345" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-449" value="Node KN4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6413" y="2770.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-453" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-451" target="Yh95EMxYVOAF0Q5FzLhY-449" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-451" value="Node KN18" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
          <mxGeometry x="-6473" y="2838.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-454" value="14) so first you establish a circuit to a rendezvous node of YOUR choice:" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7483.5" y="2379" width="403" height="26" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-469" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.163;entryY=0.073;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-455" target="Yh95EMxYVOAF0Q5FzLhY-468" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-484" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-455" target="Yh95EMxYVOAF0Q5FzLhY-483" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-455" value="Node V" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" parent="1" vertex="1">
          <mxGeometry x="-7040" y="2488.25" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-486" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-456" target="Yh95EMxYVOAF0Q5FzLhY-482" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-456" value="Node Y1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-6863" y="2362" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-460" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-457" target="Yh95EMxYVOAF0Q5FzLhY-458" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-457" value="Node X2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-6980" y="2305.75" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-462" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.956;entryY=0.167;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-458" target="Yh95EMxYVOAF0Q5FzLhY-456" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-458" value="Node Z&lt;br&gt;(RDV)" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6a00ff;fontColor=#ffffff;strokeColor=#3700CC;" parent="1" vertex="1">
          <mxGeometry x="-6782" y="2297.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-464" value="14.1) V:&quot;X, route this msg to X2&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7192" y="2425" width="190" height="26" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-465" value="14.2) X:&quot;Z, become a RDV point &lt;br&gt;for the &lt;font style=&quot;color: rgb(153, 51, 255);&quot;&gt;Z12312AWDAW&lt;/font&gt; hash,&lt;br&gt;and route traffic back to Y-&amp;gt;V&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6909" y="2249" width="189" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-466" value="14.3) Z:&quot;RDV OK.&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6993" y="2475.5" width="117" height="26" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-467" value="15) Then, you build a circuit in the &quot;4*&quot; neighborhood to ask your packets to be routed&lt;br&gt;to the hidden service 44AWDAWDSWA&#39;s RDV node" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7498" y="2607.5" width="472" height="41" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-470" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-468" target="Yh95EMxYVOAF0Q5FzLhY-451" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-468" value="Node W1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-6885" y="2819" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-471" value="15.1) V:&quot;hey W1, forward this packet to KN18&quot;&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;(this is a randomly selected node in the 4* neighborhood)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7200" y="2790" width="322" height="41" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-472" value="15.2) W1:&quot;hey KN18, forward this to whoever &lt;br&gt;knows the RDV of 44AWDAWDSWA&quot;&lt;div&gt;(KN18 knows that KN4 knows who knows the RDV of 44AWDAWDSWA)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6793" y="2867.5" width="404" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-473" value="15.3) KN18:&quot;hey KN4, forward this to whoever&lt;br&gt;knows the RDV of 44AWDAWDSWA&quot;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6415" y="2816" width="263" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-474" value="15.4) KN4:&quot;hey K, forward this to whoever&lt;br&gt;knows the RDV of 44AWDAWDSWA&quot;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6429" y="2723.25" width="241" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-475" value="16) Node A (the actual destination of hidden service A3)&lt;br&gt;recieves the traffic&amp;nbsp;and decrypts it:&lt;br&gt;M: &quot;Hey Node A, pls send the response data to my RDV point Node Z!&lt;br&gt;the hash for that is &lt;font style=&quot;color: rgb(153, 51, 255);&quot;&gt;Z12312AWDAW&lt;/font&gt;!&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6497" y="2330.25" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-479" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-476" target="Yh95EMxYVOAF0Q5FzLhY-477" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-476" value="Node A1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-6602" y="2265" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-480" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-477" target="Yh95EMxYVOAF0Q5FzLhY-458" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-477" value="Node A2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-6692" y="2265" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-481" value="17) Node A forwards the responses to the requests &lt;br&gt;of that one client to the RDV point on Node Z,&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b&gt;with a circuit that Node A chooses!&amp;nbsp;&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-6705" y="2208" width="288" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-482" value="Node Y2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-6940" y="2422" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-485" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=1;entryDx=0;entryDy=0;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-483" target="Yh95EMxYVOAF0Q5FzLhY-457" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-483" value="Node X1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-7031" y="2380" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-487" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.789;entryY=0.06;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#e51400;strokeColor=#B20000;" parent="1" source="Yh95EMxYVOAF0Q5FzLhY-482" target="Yh95EMxYVOAF0Q5FzLhY-455" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R0iengJZwtPKdWFIPyWC-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="R0iengJZwtPKdWFIPyWC-1" target="R0iengJZwtPKdWFIPyWC-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R0iengJZwtPKdWFIPyWC-1" value="Node A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" parent="1" vertex="1">
          <mxGeometry x="-7433" y="5119.719999999999" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="R0iengJZwtPKdWFIPyWC-2" value="Node C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
          <mxGeometry x="-6998" y="4927.219999999999" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="R0iengJZwtPKdWFIPyWC-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="R0iengJZwtPKdWFIPyWC-3" target="R0iengJZwtPKdWFIPyWC-14" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R0iengJZwtPKdWFIPyWC-3" value="Node B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;" parent="1" vertex="1">
          <mxGeometry x="-6609.5" y="4927.219999999999" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="R0iengJZwtPKdWFIPyWC-5" value="Node A1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-7334" y="5119.719999999999" width="45" height="45" as="geometry" />
        </mxCell>
