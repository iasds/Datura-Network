        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-14" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.879;entryY=0.808;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="0E1yibbuvkSa4QKFoASH-2" target="0E1yibbuvkSa4QKFoASH-10" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-16" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.924;entryY=0.211;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="0E1yibbuvkSa4QKFoASH-2" target="0E1yibbuvkSa4QKFoASH-12" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-17" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.531;entryY=0.017;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="0E1yibbuvkSa4QKFoASH-2" target="0E1yibbuvkSa4QKFoASH-13" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-19" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.977;entryY=0.415;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="0E1yibbuvkSa4QKFoASH-7" target="0E1yibbuvkSa4QKFoASH-5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-20" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.95;entryY=0.39;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" source="0E1yibbuvkSa4QKFoASH-5" target="0E1yibbuvkSa4QKFoASH-3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-25" value="Since the adversary doesn&#39;t control&lt;br&gt;Node A, they can&#39;t see what it does &lt;br&gt;from the system level&lt;br&gt;&lt;br&gt;And&amp;nbsp;&lt;b&gt;since the traffic looks the same from node A&lt;br&gt;to Client A,B,C, and D, the adversary can&#39;t tell who&#39;s&lt;br&gt;the real recipient from looking at the traffic shape nor timing.&lt;br&gt;(since they all recieve the same traffic at the same time,&amp;nbsp;&lt;br&gt;either as the real destination, or as noise decoy)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1758" y="3200.5" width="365" height="156" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-26" value="(just like tor guard relays,&lt;br&gt;&lt;font style=&quot;color: rgb(255, 128, 0);&quot;&gt;&lt;font color=&quot;#ff8000&quot;&gt;except that here we&#39;re going&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#ff8000&quot;&gt;to motivate and incentivize&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#ff8000&quot;&gt;all users to run and use &lt;br&gt;their own node at every turn&lt;/font&gt;&lt;/font&gt;)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1646.75" y="2938" width="171" height="84" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-30" value="(typical vanity v3 hidden services &lt;br&gt;with rendezvous just like in Tor)" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="527" y="281" width="193" height="41" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-34" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Either Noise traffic OR legit traffic&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1848" y="2315" width="195" height="26" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-35" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Legit traffic&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1912" y="2347" width="76" height="26" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-36" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;The protocol is being enforced by BOTH the clientside and the serverside:&lt;br&gt;ANYONE THAT MISBEHAVES BANS EACH OTHER!&lt;/font&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1805" y="2255" width="411" height="41" as="geometry" />
        </mxCell>
        <mxCell id="0E1yibbuvkSa4QKFoASH-37" value="AND IMPORTANT PART:&lt;div&gt;THE NODES DON&#39;T DECIDE WHERE THE PACKET GOES,&lt;/div&gt;&lt;div&gt;ONLY THE CLIENTS DECIDE WHERE THEIR CONNECTIONS GOES !!!!&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;IF A NODE MISBEHAVES WHEN QUERIED BY THE CLIENT, IT GETS BANNED&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-628" y="2632" width="453" height="84" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-1" value="&lt;u&gt;The Nodes&#39; IPs are publicly listed&lt;br&gt;(in the repository directly ?)&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-444" y="2896.5" width="228" height="61" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-43" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="v3IIzgveTb6yj0TpXEEh-41" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-205.65517241379303" y="3173" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-41" value="Client A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-386" y="3150.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="v3IIzgveTb6yj0TpXEEh-42" value="Client A, upon installing the nowhere network daemon,&lt;div&gt;immediately knows where he can try to connect to, since&lt;br&gt;all the nodes are public, and hardcoded into the repository&lt;br&gt;(and updated every week to welcome new nodes ?)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-558" y="3072.5" width="327" height="70" as="geometry" />
        </mxCell>
