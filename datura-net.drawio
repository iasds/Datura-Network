          <mxGeometry x="-5279" y="1174.5" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-44" value="Node C" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-5279" y="1274.5" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-46" value="Node A solved D&#39;s RandomX Challenge,&lt;br&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;but since Node A is D&#39;s only client,&lt;br&gt;then D refuses to forward anything&lt;br&gt;because there&#39;s no crowd for &lt;br&gt;A&#39;s traffic to blend into&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-5125" y="1079" width="232" height="84" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-47" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fillColor=#008a00;strokeColor=#005700;strokeWidth=5;" parent="1" source="gpJT7tqyTfhan1vEU41s-48" target="gpJT7tqyTfhan1vEU41s-49" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-48" value="Node A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4809.5" y="1073" width="60" height="60" as="geometry" />
        </mxCell>
