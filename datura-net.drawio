        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-15" value="Node D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-4571" y="733" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gpJT7tqyTfhan1vEU41s-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#d80073;strokeColor=#A50040;" parent="1" source="gpJT7tqyTfhan1vEU41s-17" target="gpJT7tqyTfhan1vEU41s-15" edge="1">
