        <mxCell id="R0iengJZwtPKdWFIPyWC-84" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Decoy traffic to A&lt;/font&gt; can be recieved from [Nodes BCDE]&lt;br&gt;But &lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;Real traffic to A&lt;/font&gt; can only come from the trusted Node B" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
