        <mxCell id="Ks_VO9Inp2RuTejZyS4B-25" value="&lt;font style=&quot;color: rgb(0, 255, 255);&quot;&gt;4)&amp;nbsp;&lt;br&gt;&quot;C will know where to &lt;br&gt;foward the packets&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2006" y="2270" width="132" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-26" value="&lt;font style=&quot;color: rgb(0, 255, 255);&quot;&gt;5)&lt;br&gt;&quot;B will know where to &lt;br&gt;foward the packets&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2129" y="2268" width="131" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-27" value="&lt;font style=&quot;color: rgb(0, 255, 255);&quot;&gt;6)&lt;br&gt;&quot;A will know where to&lt;br&gt;foward the packets&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2269" y="2268" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-28" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;7) A handles&lt;br&gt;the packets, &lt;/font&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;BUT&lt;br&gt;also forwards them to&lt;br&gt;3 decoy destinations&lt;br&gt;(&lt;b&gt;to act as if it wasnt&lt;br&gt;the real destination&lt;/b&gt;)&lt;/font&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2477" y="2163.5" width="133" height="98" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-29" value="Node E" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" parent="1" vertex="1">
          <mxGeometry x="-2569" y="2238.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-30" value="Node D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" parent="1" vertex="1">
          <mxGeometry x="-2569" y="2308.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-31" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;8) Nodes F, E and D&lt;br&gt;recieve the traffic and&lt;br&gt;discard it as it wasnt&lt;br&gt;meant for them&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2704" y="2197.5" width="133" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-32" value="Node F" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" parent="1" vertex="1">
          <mxGeometry x="-2569" y="2163.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-33" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;(along the way, node A, B, C and D still send the packets&lt;br&gt;to 2 other decoy destinations every time)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2232" y="2347" width="319" height="41" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#0050ef;strokeColor=#001DBC;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-34" target="Ks_VO9Inp2RuTejZyS4B-35" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-34" value="Node G" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
          <mxGeometry x="-2204" y="2407" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#0050ef;strokeColor=#001DBC;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-35" target="Ks_VO9Inp2RuTejZyS4B-36" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-35" value="Node H" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
          <mxGeometry x="-2057" y="2407" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#0050ef;strokeColor=#001DBC;" parent="1" source="Ks_VO9Inp2RuTejZyS4B-36" target="Ks_VO9Inp2RuTejZyS4B-21" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-36" value="Node I" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fa6800;fontColor=#000000;strokeColor=#C73500;" parent="1" vertex="1">
          <mxGeometry x="-1947" y="2407" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-41" value="&lt;font style=&quot;color: rgb(0, 127, 255);&quot;&gt;9) Then, instead of&lt;br&gt;directly responding to &lt;br&gt;Node B, Node A responds&lt;br&gt;to the clients by going &lt;br&gt;through another circuit&lt;br&gt;&lt;br&gt;(meaning that hidden&lt;br&gt;service connections&lt;br&gt;are bi-circuit,&lt;br&gt;and unidirectionnal)&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2479" y="2271" width="156" height="170" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-42" value="10) for the adversary observing the network traffic,&lt;br&gt;it looks like Node A wasn&#39;t the real destination,&lt;br&gt;it only looks like Node A forwarded traffic and did&lt;br&gt;a connection going elsewhere." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-2622" y="2034" width="285" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-43" value="&lt;u&gt;Hidden service domain resolution:&lt;br&gt;hiding who&#39;s the real hidden service:&lt;br&gt;(uni-directionnal + bi-circuit variant)&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-2705" y="1973" width="228" height="61" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-44" value="&lt;u&gt;The end user also chooses the decoy destinations&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
