        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-42" value="&lt;font style=&quot;color: rgb(255, 128, 0);&quot;&gt;1) A: &lt;br&gt;&quot;B, i know who knows&lt;br&gt;where Nowhere.nw is!&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1222" y="2199.5" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-43" value="&lt;font style=&quot;color: rgb(255, 128, 0);&quot;&gt;2) B:&lt;br&gt;&quot;C, i know who knows&lt;br&gt;where Nowhere.nw is!&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1092" y="2201.5" width="140" height="55" as="geometry" />
