        <mxCell id="Ks_VO9Inp2RuTejZyS4B-21" value="4) Users&lt;br&gt;that wants to access Nowhere.nw" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
