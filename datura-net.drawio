        <mxCell id="Yh95EMxYVOAF0Q5FzLhY-247" value="Node E" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#0050ef;fontColor=#ffffff;strokeColor=#001DBC;" parent="1" vertex="1">
