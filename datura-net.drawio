        <mxCell id="yjcX_oRv-ezx0EmfgUO8-24" value="&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;user C&lt;/span&gt;&lt;br style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;(can be the&lt;/span&gt;&lt;br style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;adversary)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="557" y="2571" width="85" height="85" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-25" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#008a00;strokeColor=#005700;strokeWidth=2;" parent="1" source="yjcX_oRv-ezx0EmfgUO8-18" target="yjcX_oRv-ezx0EmfgUO8-19" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1300" y="2595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-26" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=-0.012;entryY=0.394;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#008a00;strokeColor=#005700;strokeWidth=2;" parent="1" source="yjcX_oRv-ezx0EmfgUO8-6" target="yjcX_oRv-ezx0EmfgUO8-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-27" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.016;entryY=0.667;entryDx=0;entryDy=0;entryPerimeter=0;fillColor=#008a00;strokeColor=#005700;strokeWidth=2;" parent="1" source="yjcX_oRv-ezx0EmfgUO8-10" target="yjcX_oRv-ezx0EmfgUO8-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-28" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fillColor=#008a00;strokeColor=#005700;strokeWidth=2;" parent="1" source="yjcX_oRv-ezx0EmfgUO8-14" target="yjcX_oRv-ezx0EmfgUO8-19" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-29" value="To prevent the adversary from figuring out where the hidden service is, there are 3 defenses:&lt;br&gt;&lt;br&gt;1)&amp;nbsp;the traffic will arrive at the destination, but also at 2 other decoy destinations (which the nodes will remember and &lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;keep sending traffic to for as long as the hidden service remains there)&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(the decoy destinations anyway cant decrypt it, so they treat it as noise and discard it)&lt;br&gt;2) random noise is added to the actual traffic, which the destination will anyway discard upon recieving it&lt;br&gt;3) the traffic will arrive with intentional delays, to prevent timing analysis&lt;br&gt;&lt;div style=&quot;&quot;&gt;4) the same AMOUNT of traffic is sent to the 2 other decoy destinations&lt;br&gt;5) the traffic that a user sends to a hidden service via one node, &lt;b&gt;can arrive at the hidden service from multiple nodes in random order,&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;the destination anyway waits for all the packages to arrive, to then process them.&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="656.75" y="2172" width="755" height="156" as="geometry" />
        </mxCell>
        <mxCell id="yjcX_oRv-ezx0EmfgUO8-30" value="&lt;font style=&quot;color: rgb(51, 255, 51);&quot;&gt;Client A&lt;br&gt;(Decoy A)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="944" y="2328" width="71" height="71" as="geometry" />
        </mxCell>
