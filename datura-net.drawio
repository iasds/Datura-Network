        <mxCell id="hRJDUBrgxpCJInATjKRH-50" value="&lt;font style=&quot;color: rgb(0, 255, 255);&quot;&gt;4)&amp;nbsp;&lt;br&gt;&quot;C will know where to &lt;br&gt;foward the packets&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-896" y="2284.5" width="132" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-51" value="&lt;font style=&quot;color: rgb(0, 255, 255);&quot;&gt;5)&lt;br&gt;&quot;B will know where to &lt;br&gt;foward the packets&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1019" y="2282.5" width="131" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-52" value="&lt;font style=&quot;color: rgb(0, 255, 255);&quot;&gt;6)&lt;br&gt;&quot;A will know where to&lt;br&gt;foward the packets&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1159" y="2282.5" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-54" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;7) A handles&lt;br&gt;the packets, &lt;/font&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;BUT&lt;br&gt;also forwards them to&lt;br&gt;3 decoy destinations&lt;br&gt;(&lt;b&gt;to act as if it wasnt&lt;br&gt;the real destination&lt;/b&gt;)&lt;/font&gt;&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1351" y="2382.5" width="133" height="98" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-55" value="Node E" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" parent="1" vertex="1">
          <mxGeometry x="-1351" y="2253.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-56" value="Node D" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" parent="1" vertex="1">
          <mxGeometry x="-1351" y="2323.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-59" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;8) Nodes F, E and D&lt;br&gt;recieve the traffic and&lt;br&gt;discard it as it wasnt&lt;br&gt;meant for them&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1486" y="2212.5" width="133" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-60" value="9) for the adversary observing the network traffic,&lt;br&gt;it looks like Node A wasn&#39;t the real destination,&lt;br&gt;looks like Node A forwarded traffic&amp;nbsp;&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1521" y="2067" width="279" height="55" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-62" value="Node F" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" parent="1" vertex="1">
          <mxGeometry x="-1351" y="2178.5" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="hRJDUBrgxpCJInATjKRH-64" value="&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;(along the way, node A, B, C and D still send the packets&lt;br&gt;to 2 other decoy destinations every time)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-1125" y="2353.5" width="319" height="41" as="geometry" />
        </mxCell>
        <mxCell id="Ks_VO9Inp2RuTejZyS4B-4" value="&lt;font style=&quot;color: rgb(255, 0, 255);&quot;&gt;UDP Hole-punching &lt;br&gt;connection, thanks to Node G&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1117" y="2973" width="176" height="41" as="geometry" />
        </mxCell>
