        <mxCell id="HgBr_yeDXLSilMWp8V1L-86" value="&lt;b&gt;ALL CONNECTIONS FROM A1, AD, and AB MUST BE INDENTICAL AND INDISTINGUISHABLE FROM EACH OTHER&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a20025;fontColor=#ffffff;strokeColor=#6F0000;" parent="1" vertex="1">
