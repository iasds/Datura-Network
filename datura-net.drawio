        <mxCell id="QwyEQrVCva4sAPg_wC5w-11" value="3) B:&quot;Hey A, here&#39;s C&#39;s status&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
