        <mxCell id="R0x5QV8EnY2qQw4VhqnM-266" value="&lt;b&gt;&lt;u&gt;Debts: (part 4) - random fake traffic&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node B -&amp;gt; A : 0mb&lt;br&gt;-Node F -&amp;gt; B : 0mb&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node F -&amp;gt; G : 0mb&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node H -&amp;gt; G : 0mb&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node K -&amp;gt; H : 0mb&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node J -&amp;gt; K : 0mb&lt;/font&gt;&lt;br&gt;&lt;font&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node E -&amp;gt; J : 0mb&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;-Node A -&amp;gt; E : 2mb&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;font&gt;&lt;font&gt;&lt;font color=&quot;#ff3333&quot;&gt;-Node H -&amp;gt; D: 1mb&lt;/font&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(255, 51, 51);&quot;&gt;-Node H -&amp;gt; K: 1mb&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#ff3333&quot;&gt;-Node G -&amp;gt; C: 2mb&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node B -&amp;gt; C: 0mb&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node E -&amp;gt; B: 0mb&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node F -&amp;gt; E: 0mb&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;-Node J -&amp;gt; F: 0mb&lt;/font&gt;&lt;/font&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
