        <mxCell id="Ks_VO9Inp2RuTejZyS4B-17" value="&lt;font style=&quot;color: rgb(255, 128, 0);&quot;&gt;1) A: &lt;br&gt;&quot;B, i know who knows&lt;br&gt;where Nowhere.nw is!&quot;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
