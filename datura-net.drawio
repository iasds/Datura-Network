        <mxCell id="Ngk5pmv2VPOzCpttfcHT-118" value="Clients" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" parent="1" vertex="1">
          <mxGeometry x="-7172.75" y="-220.25" width="45" height="45" as="geometry" />
        </mxCell>
        <mxCell id="Ngk5pmv2VPOzCpttfcHT-121" value="&quot;Hey X, those packets are for the hidden service whose hash is 44AWDDADW, pls route them for me&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7151.5" y="-98.25" width="558" height="26" as="geometry" />
        </mxCell>
        <mxCell id="Ngk5pmv2VPOzCpttfcHT-122" value="&quot;Hey Y, Y1 and Y2, those packets are for the hidden service whose hash is 33AWDDTKWD&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7133.5" y="43" width="507" height="26" as="geometry" />
        </mxCell>
        <mxCell id="Ngk5pmv2VPOzCpttfcHT-123" value="&quot;Hey Z, Z1 and Z2, those packets are for the hidden service whose hash is 22DWAIMFASX&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7139.75" y="177.25" width="507" height="26" as="geometry" />
        </mxCell>
        <mxCell id="Ngk5pmv2VPOzCpttfcHT-124" value="&quot;Hey A, A1 and A2, those packets are for the hidden service whose hash is 11UHWFILAJD&quot;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7149.5" y="323.25" width="503" height="26" as="geometry" />
        </mxCell>
        <mxCell id="Ngk5pmv2VPOzCpttfcHT-125" value="&lt;font style=&quot;color: rgb(255, 128, 0);&quot;&gt;X knows that they are routing packets for the hidden service whose hash is 44AWDDADW,&lt;br&gt;if they know that dwawadwadwad.nw exists, they could determine that it&#39;s hash is 44AWDDADW&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;but they don&#39;t know if the real next hop is Y, Y1 or Y2.&lt;br&gt;AND X doesn&#39;t know that Node A is the actual hidden service destination either&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7104" y="-72" width="530" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Ngk5pmv2VPOzCpttfcHT-126" value="&lt;font&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Y doesn&#39;t know that they are routing packets for the hidden service whose hash is 44AWDDADW,&lt;br&gt;because they recieved requests for the 33AWDDTKWD hash&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;and they don&#39;t know if the real next hop is Z, Z1 or Z2.&lt;br&gt;AND Y doesn&#39;t know that Node A is the actual hidden service destination either&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7086.5" y="78.5" width="535" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Ngk5pmv2VPOzCpttfcHT-127" value="&lt;font&gt;&lt;font color=&quot;#00ff00&quot;&gt;Z doesn&#39;t know that they are routing packets for the hidden service whose hash is 44AWDDADW,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#00ff00&quot;&gt;because they recieved requests for the&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;22DWAIMFASX&lt;/font&gt;&lt;font color=&quot;#00ff00&quot;&gt;&amp;nbsp;hash&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;and they don&#39;t know if the real next hop is A, A1 or A2.&lt;br&gt;AND Z doesn&#39;t know that Node A is the actual hidden service destination either&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7103.5" y="222" width="534" height="70" as="geometry" />
        </mxCell>
        <mxCell id="Ngk5pmv2VPOzCpttfcHT-128" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Y1, Y2, Z1, Z2, A1 and A2&lt;br&gt;are all decoy destinations. they&lt;br&gt;recieve the same packets&lt;br&gt;but since they can&#39;t decrypt them,&lt;br&gt;they discard them.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="-7472" y="88.5" width="196" height="84" as="geometry" />
        </mxCell>
        <mxCell id="yHlu05vcTjv1aAurlMiM-2" value="&lt;u&gt;asking nodes to route packets for you, in exchange for a PoW challenge solution&lt;/u&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-7369.5" y="-1358" width="228" height="61" as="geometry" />
        </mxCell>
